{{!--
  Schamanen-Rituale-Browser für DSA 4.1 — Listen-Layout, gruppiert nach Grad
  Click auf Ritual-Namen öffnet Detail-Dialog mit Volltext
--}}
<form class="dsa-sham-app">
  <header class="dsa-sham-header">
    <div class="dsa-sham-actor">
      <h2><i class="fas fa-feather-alt"></i> {{actorName}}</h2>
      <div class="dsa-sham-actor-meta">
        <div class="dsa-sham-stat"><span class="lbl">Kultur</span><span class="val">{{kultur}}</span></div>
        <div class="dsa-sham-stat"><span class="lbl">AsP</span><span class="val">{{asp.current}} / {{asp.max}}</span></div>
        {{#if asp.permanent}}<div class="dsa-sham-stat"><span class="lbl">pAsP</span><span class="val">{{asp.permanent}}</span></div>{{/if}}
      </div>
    </div>
    <div class="dsa-sham-fert">
      {{#each fertigkeiten}}
        <button type="button" class="fert-btn" data-action="set-rkw" data-fertigkeit="{{key}}" title="Klick zum Bearbeiten">
          <span class="fert-name">{{label}}</span>
          <span class="fert-rkw">{{rkw}}</span>
          <span class="fert-probe">{{#each probe}}{{this}}{{#unless @last}}/{{/unless}}{{/each}}</span>
        </button>
      {{/each}}
    </div>
  </header>

  <div class="dsa-sham-filters">
    <label>
      <span>Kultur</span>
      <select name="kultur">
        <option value="">Alle Kulturen</option>
        {{#each kulturen}}
          <option value="{{code}}" {{#if (eq code ../kultur)}}selected{{/if}}>{{code}} — {{label}}</option>
        {{/each}}
      </select>
    </label>
    <label>
      <span>Fertigkeit</span>
      <select name="fertigkeit">
        <option value="">Alle</option>
        <option value="geister-rufen"     {{#if (eq fertigkeitFilter "geister-rufen")}}selected{{/if}}>Geister rufen</option>
        <option value="geister-bannen"    {{#if (eq fertigkeitFilter "geister-bannen")}}selected{{/if}}>Geister bannen</option>
        <option value="geister-binden"    {{#if (eq fertigkeitFilter "geister-binden")}}selected{{/if}}>Geister binden</option>
        <option value="geister-aufnehmen" {{#if (eq fertigkeitFilter "geister-aufnehmen")}}selected{{/if}}>Geister aufnehmen</option>
      </select>
    </label>
    <label class="grow">
      <span>Suche</span>
      <input type="text" name="search" placeholder="Name oder Effekt durchsuchen…">
    </label>
  </div>

  <div class="dsa-sham-list-wrap">
    {{#each ritualeByGrad}}
      <details class="dsa-sham-grad-section" open>
        <summary class="dsa-sham-grad-header">
          <span class="grad-label">Grad {{grad}}</span>
          <span class="grad-count">{{rituale.length}} Rituale</span>
          <span class="grad-cost">{{aspKosten}}{{#if perm}} ({{perm}} perm.){{/if}}</span>
        </summary>
        <table class="dsa-sham-table">
          <thead>
            <tr>
              <th class="col-name">Name</th>
              <th class="col-ziel">Ziel</th>
              <th class="col-fert">Fertigkeit</th>
              <th class="col-dauer">Ritualdauer</th>
              <th class="col-kulturen">Kulturen</th>
              <th class="col-action"></th>
            </tr>
          </thead>
          <tbody>
            {{#each rituale}}
              <tr class="dsa-sham-row{{#if petromantie}} is-petromantie{{/if}}" data-id="{{id}}">
                <td class="col-name">
                  <a href="#" data-action="show-detail" data-id="{{id}}">
                    {{#if petromantie}}<span class="petro-mark" title="Petromantie">⛏</span>{{/if}}
                    {{name}}
                    {{#if subtitel}}<small class="subtitel">({{subtitel}})</small>{{/if}}
                  </a>
                </td>
                <td class="col-ziel">{{ziel}}</td>
                <td class="col-fert">
                  <span class="fert-pill-tiny">{{fertigkeit}}</span>
                </td>
                <td class="col-dauer">{{ritualdauer}}</td>
                <td class="col-kulturen">
                  {{#if kulturen}}{{#each kulturen}}<span class="kultur-pill-tiny">{{this}}</span>{{/each}}{{/if}}
                </td>
                <td class="col-action">
                  <button type="button" class="cast-mini" data-action="cast-ritual" data-id="{{id}}" title="Ritual durchführen">
                    <i class="fas fa-feather-alt"></i>
                  </button>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </details>
    {{/each}}
  </div>

  {{#unless ritualeByGrad.length}}
    <div class="dsa-sham-empty">
      <i class="fas fa-search"></i>
      <p>Keine Rituale gefunden — Filter anpassen oder andere Kultur wählen.</p>
    </div>
  {{/unless}}

  {{#if keulenRituale.length}}
    <details class="dsa-sham-details-extra">
      <summary><i class="fas fa-bone"></i> Knochenkeulen-Rituale ({{keulenRituale.length}})</summary>
      <table class="dsa-sham-extra-table">
        <thead><tr><th>Ritual</th><th>Voraussetzung</th><th>Probe</th><th>Kosten</th><th>AP</th></tr></thead>
        <tbody>
          {{#each keulenRituale}}
            <tr><td><strong>{{name}}</strong></td><td>{{vor}}</td><td>{{probe}}</td><td>{{kosten}}</td><td>{{ap}}</td></tr>
          {{/each}}
        </tbody>
      </table>
    </details>
  {{/if}}

  {{#if knochenkeulen.length}}
    <details class="dsa-sham-details-extra">
      <summary><i class="fas fa-hammer"></i> Knochenkeulen-Kampfwerte</summary>
      <table class="dsa-sham-extra-table">
        <thead><tr><th>Typ</th><th>TP</th><th>TPKK</th><th>Gew.</th><th>BF</th><th>INI</th><th>WM</th><th>DK</th><th>Talent</th></tr></thead>
        <tbody>
          {{#each knochenkeulen}}
            <tr><td><strong>{{typ}}</strong></td><td>{{tp}}</td><td>{{tpkk}}</td><td>{{gew}}</td><td>{{bf}}</td><td>{{ini}}</td><td>{{wm}}</td><td>{{dk}}</td><td>{{talent}}</td></tr>
          {{/each}}
        </tbody>
      </table>
    </details>
  {{/if}}
</form>

<style>
.dsa-sham-app {
  display: flex; flex-direction: column; gap: 12px; padding: 12px;
  background: #15181c; color: #e8eef4;
  font-family: "Crimson Text", Georgia, serif; font-size: 14px; line-height: 1.4;
  height: 100%; overflow-y: auto;
}

/* Header */
.dsa-sham-header {
  display: flex; justify-content: space-between; align-items: flex-start;
  gap: 16px; padding: 14px 16px;
  background: linear-gradient(180deg, #1f2530 0%, #1a1f28 100%);
  border: 1px solid #2c3340; border-radius: 6px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.4);
}
.dsa-sham-actor h2 {
  margin: 0 0 8px 0; font-size: 22px; color: #a0d0e8; font-weight: 700;
  letter-spacing: 0.5px; text-shadow: 0 1px 2px rgba(0,0,0,0.6); border: none;
}
.dsa-sham-actor h2 i { color: #a0d0e8; margin-right: 6px; }
.dsa-sham-actor-meta { display: flex; gap: 18px; flex-wrap: wrap; }
.dsa-sham-stat { display: flex; flex-direction: column; gap: 2px; }
.dsa-sham-stat .lbl { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: #8090a0; font-weight: 600; }
.dsa-sham-stat .val { font-size: 17px; font-weight: 700; color: #e8eef4; }

/* Geister-Fertigkeiten */
.dsa-sham-fert {
  display: grid; grid-template-columns: repeat(2, minmax(140px, 1fr)); gap: 6px;
}
.fert-btn {
  background: linear-gradient(180deg, #1c2530 0%, #161d26 100%);
  border: 1px solid #2c3a4a; border-radius: 4px; color: #e8eef4;
  padding: 8px 12px; display: flex; flex-direction: column; align-items: flex-start;
  gap: 2px; cursor: pointer; transition: all 0.15s;
}
.fert-btn:hover { border-color: #a0d0e8; background: linear-gradient(180deg, #243040 0%, #1c2530 100%); }
.fert-btn .fert-name { font-size: 13px; font-weight: 700; color: #a0d0e8; }
.fert-btn .fert-rkw { font-size: 22px; font-weight: 700; color: #ffd770; line-height: 1; }
.fert-btn .fert-probe { font-size: 10px; color: #8090a0; letter-spacing: 0.5px; }

/* Filter */
.dsa-sham-filters {
  display: flex; gap: 12px; align-items: flex-end; padding: 10px 14px;
  background: rgba(0,0,0,0.3); border: 1px solid #232a35; border-radius: 4px;
}
.dsa-sham-filters label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: #8090a0; }
.dsa-sham-filters label.grow { flex: 1; }
.dsa-sham-filters label span { font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; font-size: 10px; }
.dsa-sham-filters select,
.dsa-sham-filters input {
  background: #1c2530 !important; color: #e8eef4 !important;
  border: 1px solid #2c3a4a !important; border-radius: 3px;
  padding: 6px 10px; font-size: 14px; font-family: inherit;
}
.dsa-sham-filters select option { background: #15181c !important; color: #e8eef4 !important; padding: 4px 8px; }
.dsa-sham-filters select option:checked,
.dsa-sham-filters select option:hover { background: #2c3a4a !important; color: #a0d0e8 !important; }
.dsa-sham-filters select:focus,
.dsa-sham-filters input:focus { outline: none; border-color: #a0d0e8 !important; box-shadow: 0 0 6px rgba(160, 208, 232, 0.3); }

/* Liste / Grad-Sections */
.dsa-sham-list-wrap { display: flex; flex-direction: column; gap: 8px; }

.dsa-sham-grad-section {
  background: rgba(0,0,0,0.25); border: 1px solid #2a3340; border-radius: 5px; overflow: hidden;
}
.dsa-sham-grad-header {
  cursor: pointer; list-style: none;
  display: flex; align-items: center; gap: 14px;
  padding: 10px 14px;
  background: linear-gradient(90deg, #1f2530 0%, #1a1f28 100%);
  border-bottom: 1px solid #2c3340;
}
.dsa-sham-grad-header::-webkit-details-marker { display: none; }
.dsa-sham-grad-header::before {
  content: "▶"; color: #a0d0e8; font-size: 11px; transition: transform 0.2s;
}
.dsa-sham-grad-section[open] .dsa-sham-grad-header::before { transform: rotate(90deg); }
.dsa-sham-grad-header .grad-label { font-size: 16px; font-weight: 700; color: #a0d0e8; letter-spacing: 1px; }
.dsa-sham-grad-header .grad-count { font-size: 13px; color: #8090a0; flex: 1; }
.dsa-sham-grad-header .grad-cost {
  font-size: 12px; color: #d0e0f0;
  padding: 3px 10px; background: rgba(160, 208, 232, 0.12);
  border-radius: 12px; border: 1px solid rgba(160, 208, 232, 0.3);
}

/* Tabelle */
.dsa-sham-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.dsa-sham-table thead tr { background: rgba(0,0,0,0.4); }
.dsa-sham-table th {
  padding: 6px 10px; text-align: left; font-size: 10px;
  font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;
  color: #8090a0; border-bottom: 1px solid #2c3340;
}
.dsa-sham-row { border-bottom: 1px solid rgba(255,255,255,0.04); transition: background 0.15s; }
.dsa-sham-row:hover { background: rgba(160, 208, 232, 0.06); }
.dsa-sham-row.is-petromantie { background: rgba(232, 200, 144, 0.04); }
.dsa-sham-row.is-petromantie:hover { background: rgba(232, 200, 144, 0.10); }
.dsa-sham-row td { padding: 7px 10px; vertical-align: middle; color: #e8eef4; }
.dsa-sham-row .col-name a {
  color: #a0d0e8; text-decoration: none; font-weight: 600; cursor: pointer;
}
.dsa-sham-row .col-name a:hover { text-decoration: underline; color: #c8e0f4; }
.dsa-sham-row.is-petromantie .col-name a { color: #e8c890; }
.dsa-sham-row.is-petromantie .col-name a:hover { color: #f8d8a0; }
.subtitel { color: #707888; font-size: 11px; font-style: italic; margin-left: 4px; font-weight: 400; }
.petro-mark { color: #e8c890; margin-right: 4px; }
.col-ziel, .col-dauer { font-size: 12px; color: #b8c0d0; }
.col-fert { font-size: 11px; }
.fert-pill-tiny {
  display: inline-block; background: rgba(180, 220, 140, 0.12);
  color: #c8e0a0; padding: 1px 8px; border-radius: 8px;
  font-size: 10px; border: 1px solid rgba(180, 220, 140, 0.25);
  font-weight: 600; text-transform: lowercase;
}
.kultur-pill-tiny {
  display: inline-block; background: rgba(200, 160, 220, 0.12);
  color: #d8b8e0; padding: 1px 6px; border-radius: 8px;
  font-size: 10px; border: 1px solid rgba(200, 160, 220, 0.2);
  margin-right: 3px;
}
.col-action { width: 36px; text-align: center; }
.cast-mini {
  background: linear-gradient(180deg, #2a4060 0%, #1a2840 100%);
  border: 1px solid #3a5070; border-radius: 3px; color: #a0d0e8;
  padding: 4px 8px; cursor: pointer; font-size: 12px; transition: all 0.15s;
}
.cast-mini:hover {
  background: linear-gradient(180deg, #3a5070 0%, #2a4060 100%);
  border-color: #a0d0e8; box-shadow: 0 0 6px rgba(160, 208, 232, 0.4);
}
.dsa-sham-row.is-petromantie .cast-mini {
  background: linear-gradient(180deg, #5a4030 0%, #3a2818 100%);
  border-color: #6a4830; color: #e8c890;
}
.dsa-sham-row.is-petromantie .cast-mini:hover {
  border-color: #e8c890; box-shadow: 0 0 6px rgba(232, 200, 144, 0.4);
}

/* Empty State */
.dsa-sham-empty {
  text-align: center; padding: 40px 20px; color: #707888;
  background: rgba(0,0,0,0.2); border-radius: 4px; border: 1px dashed #2a3340;
}
.dsa-sham-empty i { font-size: 32px; display: block; margin-bottom: 12px; color: #555a68; }
.dsa-sham-empty p { margin: 0; font-size: 14px; }

/* Extra-Tables */
.dsa-sham-details-extra {
  background: rgba(0,0,0,0.25); border: 1px solid #2a3340;
  border-radius: 4px; padding: 8px;
}
.dsa-sham-details-extra summary {
  cursor: pointer; padding: 6px; font-weight: 700; color: #a0d0e8; font-size: 14px;
}
.dsa-sham-details-extra summary i { margin-right: 6px; }
.dsa-sham-extra-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 8px; }
.dsa-sham-extra-table th, .dsa-sham-extra-table td {
  padding: 6px 10px; border-bottom: 1px solid rgba(255,255,255,0.06); text-align: left;
}
.dsa-sham-extra-table th {
  background: rgba(0,0,0,0.4); color: #a0d0e8;
  font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; font-size: 11px;
}
</style>
