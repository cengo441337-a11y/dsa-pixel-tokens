{{!--
  Detail-Dialog für ein einzelnes Schamanen-Ritual
--}}
<div class="dsa-sham-detail">
  <header class="dsa-sham-detail-head">
    <h2>
      {{#if petromantie}}<span class="petro-mark">⛏</span>{{/if}}
      {{name}}
    </h2>
    <div class="grad-display">Grad {{grad}}</div>
  </header>
  {{#if subtitel}}<div class="dsa-sham-subtitel">{{subtitel}}</div>{{/if}}

  <div class="dsa-sham-detail-meta">
    <div class="meta-row">
      <span class="meta-label">Ziel</span>
      <span class="meta-value">{{ziel}}</span>
    </div>
    <div class="meta-row">
      <span class="meta-label">Fertigkeit</span>
      <span class="meta-value">{{fertigkeit}} ({{probeAttrs}})</span>
    </div>
    <div class="meta-row">
      <span class="meta-label">Ritualdauer</span>
      <span class="meta-value">{{ritualdauer}}</span>
    </div>
    {{#if wirkungsdauer}}
    <div class="meta-row">
      <span class="meta-label">Wirkungsdauer</span>
      <span class="meta-value">{{wirkungsdauer}}</span>
    </div>
    {{/if}}
    <div class="meta-row">
      <span class="meta-label">AsP-Kosten</span>
      <span class="meta-value">{{aspKosten}}{{#if perm}} ({{perm}} permanent){{/if}}{{#if probenZuschlag}} · Zuschlag {{probenZuschlagSigned}}{{/if}}</span>
    </div>
    {{#if kulturen}}
    <div class="meta-row">
      <span class="meta-label">Kulturen</span>
      <span class="meta-value">
        {{#each kulturen}}<span class="kultur-pill">{{this}}</span>{{/each}}
      </span>
    </div>
    {{/if}}
    {{#if voraussetzung}}
    <div class="meta-row warn">
      <span class="meta-label">Voraussetzung</span>
      <span class="meta-value">{{voraussetzung}}</span>
    </div>
    {{/if}}
    {{#if merkmale}}
    <div class="meta-row">
      <span class="meta-label">Merkmale</span>
      <span class="meta-value">{{#each merkmale}}<span class="merkmal-pill">{{this}}</span>{{/each}}</span>
    </div>
    {{/if}}
  </div>

  {{#if effekt}}
  <div class="dsa-sham-detail-summary{{#if petromantie}} is-petromantie{{/if}}">
    {{effekt}}
  </div>
  {{/if}}

  {{#if symboleGesten}}
  <section class="dsa-sham-detail-section">
    <h3><i class="fas fa-hat-wizard"></i> Symbole, Gesten, Gebete</h3>
    <p>{{symboleGesten}}</p>
  </section>
  {{/if}}

  {{#if auswirkung}}
  <section class="dsa-sham-detail-section primary{{#if petromantie}} petro{{/if}}">
    <h3><i class="fas fa-bolt"></i> Auswirkung</h3>
    <p>{{auswirkung}}</p>
  </section>
  {{/if}}

  {{#if anmerkungen}}
  <section class="dsa-sham-detail-section">
    <h3><i class="fas fa-info-circle"></i> Anmerkungen</h3>
    <p>{{anmerkungen}}</p>
  </section>
  {{/if}}

  <div class="dsa-sham-detail-actions">
    <button type="button" class="cast-btn-large{{#if petromantie}} petro{{/if}}" data-action="cast-ritual" data-id="{{id}}">
      <i class="fas fa-feather-alt"></i> Ritual durchführen
    </button>
    <button type="button" class="close-btn" data-action="close">
      <i class="fas fa-times"></i> Schließen
    </button>
  </div>
</div>

<style>
.dsa-sham-detail {
  display: flex; flex-direction: column; gap: 12px; padding: 14px;
  background: #15181c; color: #e8eef4;
  font-family: "Crimson Text", Georgia, serif; font-size: 14px; line-height: 1.55;
  max-height: 100%; overflow-y: auto;
}

.dsa-sham-detail-head {
  display: flex; justify-content: space-between; align-items: flex-start;
  gap: 12px; padding-bottom: 10px; border-bottom: 2px solid #2c3340;
}
.dsa-sham-detail-head h2 {
  margin: 0; font-size: 22px; color: #a0d0e8; font-weight: 700;
  letter-spacing: 0.5px; text-shadow: 0 1px 2px rgba(0,0,0,0.6); border: none; flex: 1;
}
.dsa-sham-subtitel {
  font-size: 13px; color: #707888; font-style: italic; margin-top: -8px;
}
.petro-mark { color: #e8c890; margin-right: 6px; }
.grad-display {
  background: linear-gradient(180deg, #2a3848 0%, #1a2230 100%);
  color: #a0d0e8; padding: 6px 16px; border-radius: 14px;
  font-size: 13px; font-weight: 700; letter-spacing: 1px;
  white-space: nowrap; border: 1px solid #3a4a5e; align-self: center;
}

.dsa-sham-detail-meta {
  display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px;
  background: rgba(0,0,0,0.25); padding: 10px 14px; border-radius: 4px;
  border-left: 3px solid #5078a0;
}
.meta-row { display: flex; flex-direction: column; gap: 2px; }
.meta-row.warn { color: #e08070; }
.meta-row .meta-label {
  font-size: 10px; text-transform: uppercase; letter-spacing: 0.8px;
  color: #8090a0; font-weight: 600;
}
.meta-row.warn .meta-label { color: #e08070; }
.meta-row .meta-value { font-size: 14px; color: #e8eef4; }
.meta-row.warn .meta-value { color: #ffb0a0; }

.kultur-pill {
  display: inline-block; background: rgba(200, 160, 220, 0.12);
  color: #d8b8e0; padding: 2px 8px; border-radius: 8px;
  font-size: 11px; border: 1px solid rgba(200, 160, 220, 0.25); margin-right: 4px;
}
.merkmal-pill {
  display: inline-block; background: rgba(180, 220, 140, 0.12);
  color: #c8e0a0; padding: 2px 8px; border-radius: 8px;
  font-size: 11px; border: 1px solid rgba(180, 220, 140, 0.25); margin-right: 4px;
}

.dsa-sham-detail-summary {
  font-style: italic; color: #b8c8d8;
  background: rgba(160, 208, 232, 0.06);
  padding: 10px 14px; border-radius: 4px;
  border-left: 3px solid #5078a0; font-size: 13px;
}
.dsa-sham-detail-summary.is-petromantie {
  background: rgba(232, 200, 144, 0.08); border-left-color: #8a6a40; color: #e0d0a8;
}

.dsa-sham-detail-section {
  background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06);
  border-radius: 4px; padding: 10px 14px;
}
.dsa-sham-detail-section.primary {
  border-color: rgba(160, 208, 232, 0.3); background: rgba(80, 120, 160, 0.08);
}
.dsa-sham-detail-section.primary.petro {
  border-color: rgba(232, 200, 144, 0.3); background: rgba(138, 106, 64, 0.08);
}
.dsa-sham-detail-section h3 {
  margin: 0 0 8px 0; font-size: 14px; font-weight: 700; color: #a0d0e8;
  letter-spacing: 0.3px; border: none;
  padding-bottom: 4px; border-bottom: 1px solid rgba(160, 208, 232, 0.2);
}
.dsa-sham-detail-section.petro h3 { color: #e8c890; border-bottom-color: rgba(232, 200, 144, 0.2); }
.dsa-sham-detail-section h3 i { margin-right: 6px; opacity: 0.8; }
.dsa-sham-detail-section p { margin: 0; font-size: 14px; line-height: 1.65; color: #e8eef4; white-space: pre-wrap; }

.dsa-sham-detail-actions { display: flex; gap: 10px; margin-top: 8px; }
.cast-btn-large {
  flex: 1; background: linear-gradient(180deg, #2a4060 0%, #1a2840 100%);
  border: 1px solid #3a5070; border-radius: 4px; color: #a0d0e8;
  padding: 12px; font-size: 14px; font-weight: 700; cursor: pointer;
  letter-spacing: 0.5px; text-transform: uppercase; transition: all 0.15s;
}
.cast-btn-large:hover {
  background: linear-gradient(180deg, #3a5070 0%, #2a4060 100%);
  border-color: #a0d0e8; box-shadow: 0 0 10px rgba(160, 208, 232, 0.4);
}
.cast-btn-large.petro {
  background: linear-gradient(180deg, #5a4030 0%, #3a2818 100%);
  border-color: #6a4830; color: #e8c890;
}
.cast-btn-large.petro:hover { border-color: #e8c890; box-shadow: 0 0 10px rgba(232, 200, 144, 0.4); }
.cast-btn-large i { margin-right: 6px; }

.close-btn {
  background: rgba(0,0,0,0.3); border: 1px solid #2a3340; border-radius: 4px;
  color: #8090a0; padding: 12px 20px; font-size: 13px;
  cursor: pointer; transition: all 0.15s;
}
.close-btn:hover { background: rgba(0,0,0,0.5); color: #e8eef4; }
.close-btn i { margin-right: 4px; }
</style>
