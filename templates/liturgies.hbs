{{!--
  Liturgien-Browser für DSA 4.1 — Listen-Layout, gruppiert nach Grad
  Click auf Liturgie öffnet Detail-Dialog mit Volltext
--}}
<form class="dsa-lit-app">
  <header class="dsa-lit-header">
    <div class="dsa-lit-actor">
      <h2><i class="fas fa-praying-hands"></i> {{actorName}}</h2>
      <div class="dsa-lit-stats">
        <div class="dsa-lit-stat"><span class="lbl">Kult</span><span class="val">{{kult}}</span></div>
        <div class="dsa-lit-stat"><span class="lbl">LkW</span><span class="val">{{lkw}}</span></div>
        <div class="dsa-lit-stat"><span class="lbl">KaP</span><span class="val">{{kap.current}} / {{kap.max}}</span></div>
        {{#if kap.permanent}}<div class="dsa-lit-stat"><span class="lbl">pKaP</span><span class="val">{{kap.permanent}}</span></div>{{/if}}
      </div>
    </div>
    <div class="dsa-lit-mirakel">
      <button type="button" data-action="mirakel" data-mod="mirakelPlus" title="Gefälliges Talent (±0)">
        <i class="fas fa-hand-holding-heart"></i> Mirakel +
        <small>5 KaP · ±0</small>
      </button>
      <button type="button" data-action="mirakel" data-mod="ungelistet" title="Ungelistetes Talent (+6)">
        Mirakel ungelistet
        <small>5 KaP · +6</small>
      </button>
      <button type="button" data-action="mirakel" data-mod="mirakelMinus" title="Zuwiderlaufendes Talent (+18)">
        Mirakel −
        <small>5 KaP · +18</small>
      </button>
    </div>
  </header>

  <div class="dsa-lit-filters">
    <label>
      <span>Gott</span>
      <select name="kult">
        <option value="">Alle Götter</option>
        {{#each goetter}}
          <option value="{{this}}" {{#if (eq this ../kult)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </label>
    <label class="grow">
      <span>Suche</span>
      <input type="text" name="search" placeholder="Name oder Effekt durchsuchen…">
    </label>
  </div>

  <div class="dsa-lit-list-wrap">
    {{#each liturgienByGrad}}
      <details class="dsa-lit-grad-section" open>
        <summary class="dsa-lit-grad-header">
          <span class="grad-label">Grad {{grad}}</span>
          <span class="grad-count">{{liturgien.length}} Liturgien</span>
          <span class="grad-cost">{{kapKosten}} KaP{{#if pkap}} ({{pkap}} pKaP){{/if}}</span>
        </summary>
        <table class="dsa-lit-table">
          <thead>
            <tr>
              <th class="col-name">Name</th>
              <th class="col-ziel">Ziel</th>
              <th class="col-reichweite">Reichweite</th>
              <th class="col-dauer">Ritualdauer</th>
              <th class="col-merkmale">Merkmale</th>
              <th class="col-action"></th>
            </tr>
          </thead>
          <tbody>
            {{#each liturgien}}
              <tr class="dsa-lit-row{{#if (lookup ../../isPrimaerMap id)}} is-primaer{{/if}}" data-id="{{id}}">
                <td class="col-name">
                  <a href="#" data-action="show-detail" data-id="{{id}}">
                    {{#if (lookup ../../isPrimaerMap id)}}<span class="primaer-mark" title="Primäre Segnung">★</span>{{/if}}
                    {{name}}
                  </a>
                </td>
                <td class="col-ziel">{{ziel}}</td>
                <td class="col-reichweite">{{reichweite}}</td>
                <td class="col-dauer">{{ritualdauer}}</td>
                <td class="col-merkmale">
                  {{#if merkmale}}{{#each merkmale}}<span class="merkmal-pill-tiny">{{this}}</span>{{/each}}{{/if}}
                </td>
                <td class="col-action">
                  <button type="button" class="cast-mini" data-action="cast" data-id="{{id}}" title="Wirken">
                    <i class="fas fa-praying-hands"></i>
                  </button>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </details>
    {{/each}}
  </div>

  {{#unless liturgienByGrad.length}}
    <div class="dsa-lit-empty">
      <i class="fas fa-search"></i>
      <p>Keine Liturgien gefunden — Filter anpassen oder anderen Gott wählen.</p>
    </div>
  {{/unless}}
</form>

<style>
/* ─── DSA Liturgien-Browser, Listen-Layout ─── */
.dsa-lit-app {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 12px;
  background: #1a1612;
  color: #f0e8d8;
  font-family: "Crimson Text", Georgia, serif;
  font-size: 14px;
  line-height: 1.4;
  height: 100%;
  overflow-y: auto;
}

/* Header */
.dsa-lit-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  padding: 14px 16px;
  background: linear-gradient(180deg, #2a2018 0%, #1f1810 100%);
  border: 1px solid #3a3025;
  border-radius: 6px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.4);
}
.dsa-lit-actor h2 {
  margin: 0 0 8px 0;
  font-size: 22px;
  color: #ffd770;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-shadow: 0 1px 2px rgba(0,0,0,0.6);
  border: none;
}
.dsa-lit-actor h2 i { color: #ffd770; margin-right: 6px; }
.dsa-lit-stats { display: flex; gap: 18px; flex-wrap: wrap; }
.dsa-lit-stat { display: flex; flex-direction: column; gap: 2px; }
.dsa-lit-stat .lbl { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: #999080; font-weight: 600; }
.dsa-lit-stat .val { font-size: 17px; font-weight: 700; color: #f0e8d8; }

/* Mirakel-Buttons */
.dsa-lit-mirakel { display: flex; flex-direction: column; gap: 6px; min-width: 180px; }
.dsa-lit-mirakel button {
  background: linear-gradient(180deg, #3a2818 0%, #2a1f12 100%);
  border: 1px solid #5a4030;
  border-radius: 4px;
  color: #ffd770;
  padding: 6px 10px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1px;
  text-align: left;
  transition: all 0.15s;
}
.dsa-lit-mirakel button:hover {
  background: linear-gradient(180deg, #4a3520 0%, #3a2818 100%);
  border-color: #ffd770;
  box-shadow: 0 0 8px rgba(255, 215, 112, 0.3);
}
.dsa-lit-mirakel button small {
  font-size: 10px;
  color: #aaa080;
  font-weight: 400;
  letter-spacing: 0.5px;
}

/* Filter */
.dsa-lit-filters {
  display: flex;
  gap: 12px;
  align-items: flex-end;
  padding: 10px 14px;
  background: rgba(0,0,0,0.25);
  border: 1px solid #2a2520;
  border-radius: 4px;
}
.dsa-lit-filters label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: #aaa080; }
.dsa-lit-filters label.grow { flex: 1; }
.dsa-lit-filters label span { font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; font-size: 10px; }
.dsa-lit-filters select,
.dsa-lit-filters input {
  background: #2a2018 !important;
  color: #f0e8d8 !important;
  border: 1px solid #4a3525 !important;
  border-radius: 3px;
  padding: 6px 10px;
  font-size: 14px;
  font-family: inherit;
}
.dsa-lit-filters select option {
  background: #1c1812 !important;
  color: #f0e8d8 !important;
  padding: 4px 8px;
}
.dsa-lit-filters select option:checked,
.dsa-lit-filters select option:hover { background: #4a3525 !important; color: #ffd770 !important; }
.dsa-lit-filters select:focus,
.dsa-lit-filters input:focus { outline: none; border-color: #ffd770 !important; box-shadow: 0 0 6px rgba(255, 215, 112, 0.3); }

/* Liste / Grad-Sections */
.dsa-lit-list-wrap { display: flex; flex-direction: column; gap: 8px; }

.dsa-lit-grad-section {
  background: rgba(0,0,0,0.2);
  border: 1px solid #2a2520;
  border-radius: 5px;
  overflow: hidden;
}
.dsa-lit-grad-header {
  cursor: pointer;
  list-style: none;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 10px 14px;
  background: linear-gradient(90deg, #2a2018 0%, #1f1810 100%);
  border-bottom: 1px solid #3a3025;
}
.dsa-lit-grad-header::-webkit-details-marker { display: none; }
.dsa-lit-grad-header::before {
  content: "▶";
  color: #ffd770;
  font-size: 11px;
  transition: transform 0.2s;
}
.dsa-lit-grad-section[open] .dsa-lit-grad-header::before { transform: rotate(90deg); }
.dsa-lit-grad-header .grad-label {
  font-size: 16px;
  font-weight: 700;
  color: #ffd770;
  letter-spacing: 1px;
}
.dsa-lit-grad-header .grad-count { font-size: 13px; color: #aaa080; flex: 1; }
.dsa-lit-grad-header .grad-cost { font-size: 12px; color: #c8a060; padding: 3px 10px; background: rgba(184,132,28,0.15); border-radius: 12px; border: 1px solid rgba(184,132,28,0.3); }

/* Tabelle */
.dsa-lit-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}
.dsa-lit-table thead tr {
  background: rgba(0,0,0,0.4);
}
.dsa-lit-table th {
  padding: 6px 10px;
  text-align: left;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #999080;
  border-bottom: 1px solid #3a3025;
}
.dsa-lit-row {
  border-bottom: 1px solid rgba(255,255,255,0.04);
  transition: background 0.15s;
}
.dsa-lit-row:hover { background: rgba(255, 215, 112, 0.06); }
.dsa-lit-row.is-primaer { background: rgba(255, 215, 112, 0.04); }
.dsa-lit-row td {
  padding: 7px 10px;
  vertical-align: middle;
  color: #e8e0d0;
}
.dsa-lit-row .col-name a {
  color: #ffd770;
  text-decoration: none;
  font-weight: 600;
  cursor: pointer;
}
.dsa-lit-row .col-name a:hover { text-decoration: underline; color: #ffe898; }
.primaer-mark { color: #ffd700; margin-right: 4px; text-shadow: 0 0 4px rgba(255, 215, 0, 0.6); }
.col-ziel, .col-reichweite, .col-dauer { font-size: 12px; color: #c8b890; }
.col-merkmale { font-size: 11px; }
.merkmal-pill-tiny {
  display: inline-block;
  background: rgba(120, 200, 240, 0.12);
  color: #a0d0e0;
  padding: 1px 6px;
  border-radius: 8px;
  font-size: 10px;
  border: 1px solid rgba(120, 200, 240, 0.2);
  margin-right: 3px;
}
.col-action { width: 36px; text-align: center; }
.cast-mini {
  background: linear-gradient(180deg, #5a4030 0%, #3a2818 100%);
  border: 1px solid #6a4830;
  border-radius: 3px;
  color: #ffd770;
  padding: 4px 8px;
  cursor: pointer;
  font-size: 12px;
  transition: all 0.15s;
}
.cast-mini:hover {
  background: linear-gradient(180deg, #6a5040 0%, #4a3525 100%);
  border-color: #ffd770;
  box-shadow: 0 0 6px rgba(255, 215, 112, 0.4);
}

/* Empty State */
.dsa-lit-empty {
  text-align: center;
  padding: 40px 20px;
  color: #888070;
  background: rgba(0,0,0,0.2);
  border-radius: 4px;
  border: 1px dashed #3a3025;
}
.dsa-lit-empty i { font-size: 32px; display: block; margin-bottom: 12px; color: #666050; }
.dsa-lit-empty p { margin: 0; font-size: 14px; }
</style>
